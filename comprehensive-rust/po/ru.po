msgid "A function's API documentation, especially its safety section"
msgstr "Документация API функции, особенно раздел о безопасности (Safety)"

#: src/unsafe-deep-dive/safety-preconditions/determining.md
msgid "The source code and its internal safety comments"
msgstr "Исходный код и его внутренние комментарии о безопасности"

#: src/unsafe-deep-dive/safety-preconditions/determining.md
msgid "Module documentation"
msgstr "Документация модуля"

#: src/unsafe-deep-dive/safety-preconditions/determining.md
msgid "Rust Reference"
msgstr "Справочник Rust"

#: src/unsafe-deep-dive/safety-preconditions/determining.md
