msgid "[oreboot](https://github.com/oreboot/oreboot)"
msgstr "[oreboot](https://github.com/oreboot/oreboot)"

#: src/bare-metal/aps/other-projects.md
msgid "\"coreboot without the C\"."
msgstr "\"coreboot без C\"."

#: src/bare-metal/aps/other-projects.md
