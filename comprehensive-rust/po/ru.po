msgid ""
"// SAFETY: We know that self.registers points to the control registers\n"
"        // of a PL011 device which is appropriately mapped.\n"
msgstr ""
"// SAFETY: Мы знаем, что self.registers указывает на управляющие регистры\n"
"        // устройства PL011, которое корректно отображено.\n"

