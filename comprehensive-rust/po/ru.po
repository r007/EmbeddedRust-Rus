msgstr "\"PlainTextPassword\""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/debug.md
msgid "\"hint\""
msgstr "\"hint\""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/debug.md src/idiomatic/leveraging-the-type-system/newtype-pattern/semantic-confusion.md
msgid "\"password\""
msgstr "\"password\""

