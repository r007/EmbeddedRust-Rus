msgstr "_interoperability/rust/libanalyze/analyze.rs_"

#: src/android/interoperability/with-c/rust-library.md
msgid "//! Rust FFI demo.\n"
msgstr "//! Демонстрация FFI Rust.\n"

#: src/android/interoperability/with-c/rust-library.md
msgid ""
"/// Analyze the numbers.\n"
