msgid "Definition of Pin"
msgstr "Определение Pin"

#: src/unsafe-deep-dive/pinning.md src/unsafe-deep-dive/pinning/phantompinned.md src/unsafe-deep-dive/pinning/self-referential-buffer.md
msgid "PhantomPinned"
msgstr "PhantomPinned"

